{
  "name": "@nodus/types",
  "version": "1.0.0",
  "private": true,
  "description": "Contratos compartidos entre API y Web: enums de dominio, códigos de transición y esquemas Zod",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nodus/config": "workspace:*",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
