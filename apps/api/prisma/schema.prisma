// ============================================================================
//  NODUS — Esquema de datos
//
//  Principios que este esquema materializa:
//   · Empresa Única – Casos Múltiples  (Company ← Case 1:N, con matching previo)
//   · Consultor único                  (Consultant.code, nunca duplicado)
//   · Gobierno de LOV                  (LookupList/LookupValue; nada de texto libre crítico)
//   · Versionado sin sobrescritura     (ProposalVersion, DocumentVersion, DeliverableVersion)
//   · Auditoría append-only            (AuditLog; el cliente Prisma bloquea update/delete)
//   · SLA parametrizado                (SlaRule en BD, cero horas en código)
//   · Un único responsable principal   (índice único parcial, ver migración 002)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum RoleCode {
  SUPER_ADMIN
  ADVISORY
  CONSULTOR
  CONSULTOR_REVISOR
  CLIENTE_MIPYME
}

enum UserStatus {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum CaseStatusCode {
  CREADO
  EN_REVISION
  CLASIFICADO
  EN_POSTULACION
  ASIGNADO
  PROPUESTA_EN_DISENO
  PROPUESTA_LISTA_PARA_QA
  PROPUESTA_ENVIADA
  EN_DECISION_CLIENTE
  AJUSTES_DE_PROPUESTA
  PROPUESTA_ACEPTADA
  PENDIENTE_CONTRATACION
  AUTORIZADO_PARA_EJECUCION
  EN_EJECUCION
  LISTO_PARA_CIERRE
  CERRADO
  CERRADO_SIN_CONTRATACION
}

enum EligibilityResult {
  ELEGIBLE
  NO_ELEGIBLE
  INFORMACION_INSUFICIENTE
}

enum ConsultantStatus {
  REGISTRADO
  EN_VALIDACION
  HABILITADO
  CONDICIONADO
  SUSPENDIDO
  INACTIVO
}

enum EngagementMode {
  INDEPENDIENTE
  SPONSOR
  PROPIO
}

enum ConsultantTier {
  VALIDADO
  HABILITADO
  PREMIUM
  ESTRATEGICO
}

enum ApplicationStatus {
  PRESENTADA
  EN_EVALUACION
  ACEPTADA
  NO_SELECCIONADA
  RETIRADA
}

enum ProposalVersionStatus {
  BORRADOR
  EN_QA
  ENVIADA
  ACEPTADA
  SUPERADA
  DESCARTADA
}

enum ReviewType {
  METODOLOGICA
  PEER
}

enum ReviewOutcome {
  APROBADA
  AJUSTES_SOLICITADOS
  OBSERVACIONES
}

enum ClientDecisionType {
  ACEPTAR
  SOLICITAR_AJUSTES
  NO_CONTINUAR
}

enum ChecklistItemStatus {
  PENDIENTE
  EN_PROCESO
  CUMPLIDO
  NO_APLICA
}

enum ActivityStatus {
  NO_INICIADA
  EN_CURSO
  COMPLETADA
  BLOQUEADA
  REPROGRAMADA
}

enum MilestoneStatus {
  PENDIENTE
  EN_CURSO
  CUMPLIDO
  INCUMPLIDO
  JUSTIFICADO
  REPROGRAMADO
}

enum IncidentStatus {
  ABIERTA
  EN_ATENCION
  ESCALADA
  RESUELTA
  CERRADA
}

enum ImpactLevel {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum DeliverableStatus {
  PENDIENTE
  EN_DESARROLLO
  CARGADO
  EN_REVISION
  AJUSTADO
  LISTO_PARA_CIERRE
}

enum DocumentStage {
  INTAKE
  EVALUACION
  POSTULACION
  PROPUESTA
  DECISION
  CONTRATACION
  EJECUCION
  CIERRE
}

enum DocumentAccessLevel {
  LECTURA
  ESCRITURA
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
  CANCELLED
}

enum SlaAlertKind {
