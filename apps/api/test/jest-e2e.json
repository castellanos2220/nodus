{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json",
        "isolatedModules": true
      }
    ]
  },
  "moduleNameMapper": {
    "^@nodus/types$": "<rootDir>/../../packages/types/src/index.ts"
  },
  "globalSetup": "<rootDir>/test/setup/global-setup.ts",
  "testTimeout": 180000,
  "maxWorkers": 1
}
