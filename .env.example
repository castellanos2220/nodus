# ==============================================================================
# NODUS — variables de entorno
# Copiar a .env :  cp .env.example .env
# .env NUNCA se commitea (ver .gitignore).
# ==============================================================================

# ------------------------------------------------------------------ Entorno --
NODE_ENV=development
APP_NAME=NODUS
LOG_LEVEL=debug

# --------------------------------------------------------------- Base datos --
# Host "postgres" dentro de docker-compose; "localhost" si corres la API fuera.
POSTGRES_USER=nodus
POSTGRES_PASSWORD=nodus_dev_password
POSTGRES_DB=nodus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nodus:nodus_dev_password@localhost:5432/nodus?schema=public&connection_limit=15&pool_timeout=20

# ------------------------------------------------------------------- Puertos --
API_PORT=4000
WEB_PORT=3000

# ---------------------------------------------------------------------- URLs --
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------- Auth --
# Genera secretos reales:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_access_secret_change_me_in_production_0123456789
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_in_production_9876543210
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# ------------------------------------------------- Storage documental (S3) ---
# MinIO en local — mismo protocolo S3 que AWS/R2 en producción.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nodus_minio_access
S3_SECRET_KEY=nodus_minio_secret_key
S3_BUCKET=nodus-documents
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
# Límites de carga
MAX_FILE_SIZE_MB=25
MAX_REQUEST_BODY_MB=2

# ---------------------------------------------------------------------- SMTP --
# Mailpit en local: UI en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="NODUS <no-reply@nodus.local>"

# ----------------------------------------------------------------------- SLA --
# Intervalo del job repetible que evalúa relojes de SLA (cron).
SLA_EVALUATION_CRON=*/5 * * * *
SLA_AT_RISK_THRESHOLD_PERCENT=75

# ------------------------------------------------------------ Rate limiting --
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_SECONDS=300
THROTTLE_AUTH_LIMIT=10

# ------------------------------------------------------------------ Frontend --
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=NODUS

# -------------------------------------------------------------------- Seed ---
SEED_DEFAULT_PASSWORD=Nodus2026*
